generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String          @id @default(uuid())
  telegramId          BigInt          @unique
  firstName           String
  lastName            String?
  username            String?
  role                Role            @default(USER)
  coinsBalance        Int             @default(0)
  contentPreference   AgeRating       @default(NORMAL)
  isAgeVerified       Boolean         @default(false)
  referralCode        String          @unique
  referredById        String?
  referralCount       Int             @default(0)
  referralRewardGranted Boolean       @default(false)
  isBanned            Boolean         @default(false)
  bannedAt            DateTime?
  banReason           String?
  deletedAt           DateTime?
  bio                 String?
  avatarUrl           String?
  telegramPhotoUrl    String?
  donationLink        String?
  cryptoWalletLabel   String?
  cryptoWalletAddress String?
  customLinks         Json?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  referredBy          User?             @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]            @relation("Referrals")
  donationsReceived   Transaction[]     @relation("Receiver")
  comments            Comment[]
  transactionsSent    Transaction[]     @relation("Payer")
  bookmarks           Bookmark[]
  readHistory         ReadHistory[]
  readMarks           ChapterReadMark[]
  staffRoles          ComicStaff[]
  chapterStaffRoles   ChapterStaff[]
  chapterUnlocks      ChapterUnlock[]
  chapterReactions    ChapterReaction[]
  devToolsStrikes     DevToolsStrike[]
  publisherProfile    Publisher?
  publisherStaffRoles PublisherStaff[]
  uploadedChapters    Chapter[]         @relation("ChapterUploader")
  createdComics       Comic[]           @relation("ComicCreator")
  entitlements        Entitlement[]
  sales               Sale[]
  workRatings         WorkRating[]
  editionRatings      EditionRating[]
  contentReports      ContentReport[]
  editionRequests     EditionRequest[]
  payoutConfirmations PayoutConfirmation[]

  @@index([role])
  @@index([referredById])
  @@index([isBanned])
  @@index([deletedAt])
}

enum Role {
  USER
  VIP
  STAFF
  PUBLISHER
  ADMIN
}

model Publisher {
  id                  String   @id @default(uuid())
  name                String
  legalEntity         String?
  contactEmail        String
  contractUserId      String?  @unique
  contractUser        User?    @relation(fields: [contractUserId], references: [id])
  isVerified          Boolean  @default(false)
  bio                 String?
  avatarUrl           String?
  telegramUrl         String?
  instagramUrl        String?
  websiteUrl          String?
  donationLink        String?
  cryptoWalletLabel   String?
  cryptoWalletAddress String?
  customLinks         Json?
  createdAt           DateTime @default(now())

  licenses           License[]
  staff              PublisherStaff[]
  payoutRequests     PayoutRequest[]
  payoutTransactions Transaction[]    @relation("PublisherPayoutTransactions")
  editions            Edition[]

  @@index([isVerified])
}

model PublisherStaff {
  id             String    @id @default(uuid())
  publisherId    String
  userId         String
  role           StaffRole
  canUpload      Boolean   @default(true)
  canManageComics Boolean   @default(false)
  isVerified     Boolean   @default(false)
  createdAt      DateTime  @default(now())

  publisher Publisher @relation(fields: [publisherId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([publisherId, userId, role])
}

enum LicenseStatus {
  PENDING
  ACTIVE
  EXPIRED
  TERMINATED
}

model License {
  id                String        @id @default(uuid())
  publisherId       String
  publisher         Publisher     @relation(fields: [publisherId], references: [id])
  territory         String[]
  royaltyPercentage Decimal       @db.Decimal(5, 2)
  status            LicenseStatus @default(PENDING)
  startDate         DateTime
  endDate           DateTime?
  terminatedAt      DateTime?
  contractReference String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  comics      Comic[]
  settlements RoyaltySettlement[]
  editions    Edition[]
  terms       LicenseTerm[]

  @@index([publisherId])
  @@index([status])
}

enum ReadingDirection {
  LTR
  RTL
}

model Category {
  id                 String           @id @default(uuid())
  name               String           @unique
  slug               String           @unique
  imageUrl           String?
  readingDirection   ReadingDirection @default(LTR)
  defaultReadingMode ReadingMode      @default(VERTICAL)
  showOnHomepage     Boolean          @default(true)
  isActive           Boolean          @default(true)
  sortOrder          Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  comics Comic[]

  @@index([showOnHomepage, sortOrder])
  @@index([isActive, sortOrder])
}

enum ReadingMode {
  VERTICAL
  HORIZONTAL
  DOUBLE_PAGE
}

model Comic {
  id            String              @id @default(uuid())
  title         String
  slug          String              @unique
  description   String
  coverImage    String
  bannerImage   String?
  dominantColor String?
  ageRating     AgeRating           @default(NORMAL)
  status        ComicStatus         @default(ONGOING)
  approvalStatus ComicApprovalStatus @default(APPROVED)
  categoryId    String
  category      Category            @relation(fields: [categoryId], references: [id])
  readingMode   ReadingMode         @default(VERTICAL)
  viewCount     Int                 @default(0)
  createdById   String?
  createdBy     User?               @relation("ComicCreator", fields: [createdById], references: [id], onDelete: SetNull)
  rejectionNote String?
  createdAt     DateTime            @default(now())

  isFeaturedOnHome Boolean @default(false)
  featuredBadge    String?
  licenseId        String
  license          License @relation(fields: [licenseId], references: [id])

  ratingCount     Int @default(0)
  ratingTotal     Int @default(0)
  chapters        Chapter[]
  editions        Edition[]
  episodes        WorkEpisode[]
  ratings         WorkRating[]
  editionRequests EditionRequest[]
  staff           ComicStaff[]
  bookmarks       Bookmark[]
  transactions    Transaction[]
  genres          ComicGenre[]
  readHistory     ReadHistory[]
  readMarks       ChapterReadMark[]

  @@index([categoryId])
  @@index([licenseId])
  @@index([viewCount])
  @@index([createdAt])
  @@index([status])
  @@index([approvalStatus])
  @@index([createdById])
}

enum AgeRating {
  NORMAL
  EIGHTEEN_PLUS
  NSFW
}

enum ComicStatus {
  ONGOING
  COMPLETED
  HIATUS
}

enum ComicApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  NEEDS_CHANGES
}

model Genre {
  id       String       @id @default(uuid())
  name     String       @unique
  slug     String       @unique
  imageUrl String?
  comics   ComicGenre[]
}

model ComicGenre {
  comicId String
  genreId String
  comic   Comic @relation(fields: [comicId], references: [id])
  genre   Genre @relation(fields: [genreId], references: [id])

  @@id([comicId, genreId])
  @@index([genreId])
}

model ComicStaff {
  id        String    @id @default(uuid())
  comicId   String
  editionId String?
  userId    String
  roleTitle StaffRole
  shareBps  Int       @default(0)

  comic   Comic    @relation(fields: [comicId], references: [id])
  edition Edition? @relation(fields: [editionId], references: [id])
  user    User     @relation(fields: [userId], references: [id])

  @@unique([comicId, userId, roleTitle])
  @@index([editionId])
}

enum StaffRole {
  LOCALIZATION_SPECIALIST
  EDITOR
  CLEANER
  TYPIST
}

enum ChapterStatus {
  DRAFT
  SCHEDULED
  PENDING_APPROVAL
  PUBLISHED
}

enum ChapterAccessType {
  FREE
  COIN
}

model Chapter {
  id             String            @id @default(uuid())
  comicId        String
  editionId      String
  episodeId      String?
  chapterNumber  Float
  title          String?
  pages          String[]
  isLocked       Boolean           @default(false)
  accessType     ChapterAccessType @default(FREE)
  status         ChapterStatus     @default(DRAFT)
  scheduledAt    DateTime?
  publishedAt    DateTime?
  viewCount      Int               @default(0)
  uploadedById   String?
  createdAt      DateTime          @default(now())

  comic        Comic             @relation(fields: [comicId], references: [id])
  edition      Edition           @relation(fields: [editionId], references: [id])
  episode      WorkEpisode?      @relation(fields: [episodeId], references: [id])
  uploadedBy   User?             @relation("ChapterUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  comments     Comment[]
  staff        ChapterStaff[]
  unlocks      ChapterUnlock[]
  reactions    ChapterReaction[]
  readMarks    ChapterReadMark[]
  entitlements Entitlement[]
  saleLines    SaleLine[]

  @@index([comicId, publishedAt])
  @@unique([editionId, chapterNumber])
  @@index([editionId, publishedAt])
  @@index([episodeId])
  @@index([status, scheduledAt])
  @@index([viewCount])
  @@index([uploadedById])
}

model ChapterStaff {
  id        String    @id @default(uuid())
  chapterId String
  userId    String
  roleTitle StaffRole
  shareBps  Int       @default(0)

  chapter Chapter @relation(fields: [chapterId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([chapterId, userId, roleTitle])
}

model ChapterUnlock {
  userId    String
  chapterId String
  expiresAt DateTime?

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])

  @@id([userId, chapterId])
}

model ChapterReadMark {
  userId    String
  chapterId String
  comicId   String
  readAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])
  comic   Comic   @relation(fields: [comicId], references: [id])

  @@id([userId, chapterId])
  @@index([userId, comicId])
}

model ChapterReaction {
  id        String   @id @default(uuid())
  chapterId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  chapter Chapter @relation(fields: [chapterId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([chapterId, userId])
  @@index([chapterId])
}

model Comment {
  id            String        @id @default(uuid())
  chapterId     String
  userId        String
  content       String
  isSpoiler     Boolean       @default(false)
  isStaffReply  Boolean       @default(false)
  status        CommentStatus @default(APPROVED)
  moderatedById String?
  moderatedAt   DateTime?
  editedAt      DateTime?
  parentId      String?
  createdAt     DateTime      @default(now())

  chapter Chapter   @relation(fields: [chapterId], references: [id])
  user    User      @relation(fields: [userId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([chapterId, status])
  @@index([chapterId, createdAt])
  @@index([parentId])
  @@index([status])
}

model Bookmark {
  userId             String
  comicId            String
  notifyOnNewChapter Boolean  @default(true)
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id])
  comic              Comic    @relation(fields: [comicId], references: [id])

  @@id([userId, comicId])
}

model ReadHistory {
  userId         String
  comicId        String
  lastChapterId  String
  lastPage       Int      @default(1)
  scrollFraction Float    @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
  comic          Comic    @relation(fields: [comicId], references: [id])

  @@id([userId, comicId])
}

model Transaction {
  id       String            @id @default(uuid())
  type     TransactionType
  status   TransactionStatus @default(PENDING)
  amount   Decimal           @db.Decimal(20, 9)
  currency String            @default("IRT")

  payerId String
  payer   User   @relation("Payer", fields: [payerId], references: [id])

  receiverId String?
  receiver   User?   @relation("Receiver", fields: [receiverId], references: [id])
  message    String?

  comicId String?
  comic   Comic?  @relation(fields: [comicId], references: [id])

  coinPackageId String?
  coinPackage   CoinPackage? @relation(fields: [coinPackageId], references: [id], onDelete: SetNull)
  customCoins   Int?

  payoutPublisherId String?
  payoutPublisher   Publisher? @relation("PublisherPayoutTransactions", fields: [payoutPublisherId], references: [id])
  payoutRequest     PayoutRequest? @relation("PayoutTransaction")

  tonComment String? @unique
  tonTxHash  String?

  settlementId String?
  settlement   RoyaltySettlement? @relation(fields: [settlementId], references: [id])

  createdAt DateTime @default(now())

  @@index([comicId])
  @@index([type])
  @@index([settlementId])
  @@index([status])
  @@index([receiverId])
  @@index([coinPackageId])
  @@index([payoutPublisherId])
  @@index([createdAt])
}

enum TransactionType {
  SUBSCRIPTION
  DONATION
  COIN_PURCHASE
  CHAPTER_UNLOCK
  ADMIN_GRANT
  ADMIN_REVOKE
  PUBLISHER_PAYOUT
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
}

model CoinPackage {
  id           String   @id @default(uuid())
  coins        Int
  bonusCoins   Int      @default(0)
  badge        String?
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions Transaction[]

  @@index([isActive, sortOrder])
}

model RoyaltySettlement {
  id                    String           @id @default(uuid())
  licenseId             String
  license               License          @relation(fields: [licenseId], references: [id])
  periodStart           DateTime
  periodEnd             DateTime
  grossRevenue          Decimal          @db.Decimal(12, 2)
  publisherShare        Decimal          @db.Decimal(12, 2)
  localizationTeamShare Decimal          @db.Decimal(12, 2)
  status                SettlementStatus @default(PENDING)
  paidAt                DateTime?

  transactions Transaction[]
  createdAt    DateTime      @default(now())

  @@index([licenseId, periodStart])
}

enum SettlementStatus {
  PENDING
  PAID
  DISPUTED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model PayoutRequest {
  id            String       @id @default(uuid())
  publisherId   String
  amountToman   Decimal?     @db.Decimal(12, 2)
  amountTon     Decimal?     @db.Decimal(20, 9)
  paidAmountTon Decimal?     @db.Decimal(20, 9)
  periodStart   DateTime
  periodEnd     DateTime
  status        PayoutStatus @default(PENDING)
  reviewedById  String?
  reviewNote    String?
  requestedAt   DateTime     @default(now())
  reviewedAt    DateTime?
  paidAt        DateTime?

  publisher Publisher @relation(fields: [publisherId], references: [id])

  tonTransactionId String?      @unique
  tonTransaction   Transaction? @relation("PayoutTransaction", fields: [tonTransactionId], references: [id])

  @@index([publisherId])
  @@index([status])
}

model DevToolsStrike {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model CreatorApplication {
  id           String                   @id @default(uuid())
  fullName     String
  contact      String
  portfolioUrl String?
  message      String
  status       CreatorApplicationStatus @default(NEW)
  createdAt    DateTime                 @default(now())
}

enum CreatorApplicationStatus {
  NEW
  REVIEWING
  ACCEPTED
  REJECTED
}

model SearchTerm {
  id        String   @id @default(uuid())
  term      String   @unique
  count     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@index([count])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model PlatformSettings {
  id                       String   @id @default("singleton")
  chapterUnlockCoinCost    Int      @default(15)
  newReleaseThresholdHours Int      @default(72)
  coinPriceUsdt            Decimal  @db.Decimal(20, 6) @default(0.002)
  tomanPerUsdt             Int      @default(0)
  referralRewardCoins      Int      @default(10)
  updatedAt                DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorRole  String
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model AdminNotice {
  id          String   @id @default(uuid())
  message     String
  createdById String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

enum EditionStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum EntitlementType {
  PURCHASE
  CROSS_UNLOCK
  LEGACY_UNLOCK
  ADMIN_GRANT
}

enum SaleKind {
  SINGLE
  BULK
}

enum BeneficiaryType {
  PLATFORM
  PUBLISHER
  USER
}

enum LedgerAccount {
  USER_COIN_WALLET
  PLATFORM_REVENUE
  BENEFICIARY_PAYABLE
  BENEFICIARY_PAID
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerOwnerType {
  USER
  PUBLISHER
  PLATFORM
}

enum LedgerCurrency {
  COIN_UNIT
  USDT_MICRO
}

enum ReportTargetType {
  EDITION_CHAPTER
  COMMENT
  EDITION
  WORK
}

enum ReportCategory {
  TRANSLATION_ERROR
  BROKEN_IMAGES
  UNLABELED_SPOILER
  INAPPROPRIATE
  RIGHTS_VIOLATION
  MISLEADING_CREDIT
  BILLING_ACCESS
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  ACTION_TAKEN
  REJECTED
  RESOLVED
}

enum EditionRequestStatus {
  ACTIVE
  CANCELLED
  FULFILLED
}

enum SettlementPeriodStatus {
  OPEN
  LOCKED
}

enum SettlementLineStatus {
  CALCULATED
  APPROVED_FOR_PAYMENT
  PAID_BY_ADMIN
  CONFIRMED_BY_RECIPIENT
  ON_HOLD
  PARTIALLY_PAID
  DISPUTED
  CANCELLED
}

enum PayoutConfirmationStatus {
  CONFIRMED
  DISPUTED
}

model LicenseTerm {
  id                String   @id @default(uuid())
  licenseId         String
  royaltyPercentage Decimal  @db.Decimal(5, 2)
  validFrom         DateTime
  createdById       String?
  createdAt         DateTime @default(now())

  license License @relation(fields: [licenseId], references: [id])
  sales   Sale[]

  @@unique([licenseId, validFrom])
}

model Edition {
  id                 String        @id @default(uuid())
  workId             String
  publisherId        String
  licenseId          String
  language           String        @default("fa")
  format             String        @default("COMIC")
  title              String?
  status             EditionStatus @default(ACTIVE)
  priceCoinsOverride Int?
  crossUnlockEnabled Boolean       @default(false)
  ratingCount        Int           @default(0)
  ratingTotal        Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  work      Comic           @relation(fields: [workId], references: [id])
  publisher Publisher       @relation(fields: [publisherId], references: [id])
  license   License         @relation(fields: [licenseId], references: [id])
  chapters  Chapter[]
  staff     ComicStaff[]
  ratings   EditionRating[]
  sales     Sale[]

  @@unique([workId, publisherId, language])
  @@index([workId, status])
  @@index([publisherId])
  @@index([licenseId])
}

model WorkEpisode {
  id             String   @id @default(uuid())
  workId         String
  canonicalIndex Float
  title          String?
  createdAt      DateTime @default(now())

  work     Comic     @relation(fields: [workId], references: [id])
  chapters Chapter[]

  @@unique([workId, canonicalIndex])
}

model Entitlement {
  id         String          @id @default(uuid())
  userId     String
  chapterId  String
  type       EntitlementType
  saleLineId String?         @unique
  createdAt  DateTime        @default(now())
  expiresAt  DateTime?

  user     User      @relation(fields: [userId], references: [id])
  chapter  Chapter   @relation(fields: [chapterId], references: [id])
  saleLine SaleLine? @relation(fields: [saleLineId], references: [id])

  @@unique([userId, chapterId])
  @@index([chapterId])
}

model Sale {
  id             String   @id @default(uuid())
  buyerId        String
  editionId      String
  kind           SaleKind
  totalCoins     Int
  coinPriceUsdt  Decimal  @db.Decimal(20, 6)
  idempotencyKey String   @unique
  licenseTermId  String?
  createdAt      DateTime @default(now())

  buyer       User         @relation(fields: [buyerId], references: [id])
  edition     Edition      @relation(fields: [editionId], references: [id])
  licenseTerm LicenseTerm? @relation(fields: [licenseTermId], references: [id])
  lines       SaleLine[]

  @@index([buyerId, createdAt])
  @@index([editionId])
}

model SaleLine {
  id          String   @id @default(uuid())
  saleId      String
  chapterId   String
  coinAmount  Int
  unitsAmount Int
  createdAt   DateTime @default(now())

  sale        Sale                @relation(fields: [saleId], references: [id])
  chapter     Chapter             @relation(fields: [chapterId], references: [id])
  entitlement Entitlement?
  allocations RevenueAllocation[]

  @@index([saleId])
  @@index([chapterId])
}

model RevenueAllocation {
  id               String          @id @default(uuid())
  saleLineId       String
  beneficiaryType  BeneficiaryType
  beneficiaryId    String?
  role             StaffRole?
  baseUnits        Int
  publisherBps     Int
  memberShareBps   Int?
  allocatedUnits   Int
  usdtMicro        Int
  licenseTermId    String?
  settlementLineId String?
  createdAt        DateTime        @default(now())

  saleLine       SaleLine        @relation(fields: [saleLineId], references: [id])
  settlementLine SettlementLine? @relation(fields: [settlementLineId], references: [id])

  @@index([saleLineId])
  @@index([beneficiaryType, beneficiaryId, settlementLineId])
  @@index([createdAt])
}

model LedgerEntry {
  id             String          @id @default(uuid())
  account        LedgerAccount
  ownerType      LedgerOwnerType
  ownerId        String?
  direction      LedgerDirection
  amountUnits    BigInt
  currency       LedgerCurrency  @default(COIN_UNIT)
  sourceType     String
  sourceId       String
  idempotencyKey String          @unique
  note           String?
  createdAt      DateTime        @default(now())

  @@index([account, ownerType, ownerId])
  @@index([sourceType, sourceId])
  @@index([createdAt])
}

model WorkRating {
  id        String   @id @default(uuid())
  userId    String
  workId    String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id])
  work Comic @relation(fields: [workId], references: [id])

  @@unique([userId, workId])
  @@index([workId])
}

model EditionRating {
  id        String   @id @default(uuid())
  userId    String
  editionId String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  edition Edition @relation(fields: [editionId], references: [id])

  @@unique([userId, editionId])
  @@index([editionId])
}

model ContentReport {
  id             String           @id @default(uuid())
  reporterId     String
  targetType     ReportTargetType
  targetId       String
  category       ReportCategory
  details        String?
  status         ReportStatus     @default(OPEN)
  moderatorId    String?
  resolutionNote String?
  createdAt      DateTime         @default(now())
  resolvedAt     DateTime?

  reporter User @relation(fields: [reporterId], references: [id])

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
}

model EditionRequest {
  id        String               @id @default(uuid())
  userId    String
  workId    String
  language  String
  reason    String?
  status    EditionRequestStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User  @relation(fields: [userId], references: [id])
  work Comic @relation(fields: [workId], references: [id])

  @@unique([userId, workId])
  @@index([workId, language, status])
}

model SettlementPeriod {
  id          String                 @id @default(uuid())
  periodStart DateTime
  periodEnd   DateTime
  status      SettlementPeriodStatus @default(OPEN)
  lockedAt    DateTime?
  lockedById  String?
  createdAt   DateTime               @default(now())

  lines SettlementLine[]

  @@index([periodStart])
}

model SettlementLine {
  id              String               @id @default(uuid())
  periodId        String
  beneficiaryType BeneficiaryType
  beneficiaryId   String
  owedMicro       BigInt
  paidMicro       BigInt               @default(0)
  status          SettlementLineStatus @default(CALCULATED)
  note            String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  period      SettlementPeriod    @relation(fields: [periodId], references: [id])
  allocations RevenueAllocation[]
  payouts     Payout[]

  @@unique([periodId, beneficiaryType, beneficiaryId])
  @@index([beneficiaryType, beneficiaryId])
  @@index([status])
}

model Payout {
  id               String   @id @default(uuid())
  settlementLineId String
  amountMicro      BigInt
  reference        String?
  receiptUrl       String?
  note             String?
  paidById         String
  paidAt           DateTime @default(now())

  settlementLine SettlementLine       @relation(fields: [settlementLineId], references: [id])
  confirmation   PayoutConfirmation?

  @@index([settlementLineId])
}

model PayoutConfirmation {
  id          String                   @id @default(uuid())
  payoutId    String                   @unique
  recipientId String
  status      PayoutConfirmationStatus
  note        String?
  createdAt   DateTime                 @default(now())

  payout    Payout @relation(fields: [payoutId], references: [id])
  recipient User   @relation(fields: [recipientId], references: [id])
}
